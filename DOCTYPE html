                <p class="font-bold">سلتك فارغة حالياً</p>
              </div>
            ` : state.cart.map(item => `
              <div class="flex items-center justify-between gap-3 bg-gray-50 p-3 rounded-xl border border-gray-100">
                <div class="flex-1">
                  <h4 class="font-bold text-sm text-gray-900">${item.name}</h4>
                  <p class="text-xs text-green-800 font-bold">${item.price * item.qty} ${STORE_CONFIG.currency}</p>
                </div>
                <div class="flex items-center gap-2 bg-white border rounded-lg px-2 py-1">
                  <button onclick="updateQty(${item.id}, -1)" class="text-red-600 font-black px-1">-</button>
                  <span class="text-sm font-bold w-5 text-center">${item.qty}</span>
                  <button onclick="updateQty(${item.id}, 1)" class="text-green-700 font-black px-1">+</button>
                </div>
              </div>
            `).join("")}

            ${state.cart.length > 0 ? `
              <div class="border-t pt-4 space-y-3">
                <h4 class="font-extrabold text-sm text-gray-800">بيانات التوصيل والدفع:</h4>
                <input type="text" placeholder="الاسم الكريم" value="${state.customerName}" oninput="state.customerName = this.value"
                  class="w-full border rounded-xl px-3 py-2 text-sm" />
                <input type="tel" placeholder="رقم الهاتف / الواتساب" value="${state.customerPhone}" oninput="state.customerPhone = this.value"
                  class="w-full border rounded-xl px-3 py-2 text-sm" />
                <input type="text" placeholder="الحي / المدينة" value="${state.customerCity}" oninput="state.customerCity = this.value"
                  class="w-full border rounded-xl px-3 py-2 text-sm" />
                <select onchange="state.paymentMethod = this.value" class="w-full border rounded-xl px-3 py-2 text-sm bg-white">
                  ${STORE_CONFIG.paymentMethods.map(m => `<option value="${m}" ${state.paymentMethod === m ? 'selected' : ''}>${m}</option>`).join("")}
