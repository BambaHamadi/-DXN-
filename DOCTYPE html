<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>مقر DXN الدار النعيم - المتجر والكتالوج الرسمي</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Cairo', 'Plus Jakarta Sans', sans-serif; background-color: #f6f8f6; color: #1b2e21; margin: 0; }
    [dir="ltr"] body { font-family: 'Plus Jakarta Sans', 'Cairo', sans-serif; }
    .dxn-green { background-color: #2d6a3e; }
    .dxn-green-hover:hover { background-color: #235431; }
    .dxn-text-green { color: #2d6a3e; }
    .dxn-border-green { border-color: #2d6a3e; }
    .dxn-light-bg { background-color: #edf5ef; }
    .card-shadow { box-shadow: 0 4px 20px -2px rgba(27, 46, 33, 0.06); }
    .hero-gradient { background: linear-gradient(135deg, #f3f8f4 0%, #e1efe4 55%, #d3e7d8 100%); }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f2; }
    ::-webkit-scrollbar-thumb { background: #b8cebe; border-radius: 99px; }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
    }
    @keyframes flagWave {
      0%, 100% { transform: perspective(160px) rotateY(-10deg) skewY(1.5deg); }
      25% { transform: perspective(160px) rotateY(8deg) skewY(-2deg); }
      50% { transform: perspective(160px) rotateY(-12deg) skewY(2deg); }
      75% { transform: perspective(160px) rotateY(10deg) skewY(-1.5deg); }
    }
    @keyframes flagShimmer {
      0% { background-position: -150% 0; }
      100% { background-position: 150% 0; }
    }
    .mauritania-flag-wrap {
      display: inline-block;
      transform-origin: right center;
      animation: flagWave 2.8s ease-in-out infinite;
      box-shadow: 0 3px 10px rgba(0,0,0,0.18);
      border-radius: 4px;
      overflow: hidden;
      position: relative;
    }
    [dir="ltr"] .mauritania-flag-wrap {
      transform-origin: left center;
    }
    .mauritania-flag-wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg, rgba(255,255,255,0) 30%, rgba(255,255,255,0.28) 50%, rgba(255,255,255,0) 70%);
      background-size: 200% 100%;
      animation: flagShimmer 2.8s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes tickerScrollRTL {
      0% { transform: translateX(0); }
      100% { transform: translateX(50%); }
    }
    @keyframes tickerScrollLTR {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .product-ticker-track {
      display: flex;
      width: max-content;
      animation: tickerScrollRTL 48s linear infinite;
    }
    [dir="ltr"] .product-ticker-track {
      animation: tickerScrollLTR 48s linear infinite;
    }
    .product-ticker-container:hover .product-ticker-track {
      animation-play-state: paused;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

<div id="app"></div>

