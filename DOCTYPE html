    image: "https://images.unsplash.com/photo-1505576399279-565b52d4ac71?auto=format&fit=crop&w=400&q=80"
  },
  {
    id: 4,
    name: "قهوة كورديسيبس 3 في 1 - Cordyceps Coffee",
    category: "المشروبات الصحية",
