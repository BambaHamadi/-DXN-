              <button onclick="addToCart(${product.id})" class="no-print dxn-green dxn-green-hover text-white px-3.5 py-2 rounded-xl text-xs font-bold transition flex items-center gap-1">
                <span>+ أضف للسلة</span>
              </button>
            </div>
          </div>
        `).join("")}
      </div>
    </main>

    <!-- نافذة السلة الجانبية (Modal) -->
    ${state.isCartOpen ? `
      <div class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex justify-end no-print">
        <div class="bg-white w-full max-w-md h-full flex flex-col justify-between shadow-2xl">
          <div class="p-4 border-b flex items-center justify-between bg-green-50">
            <h3 class="font-black text-lg text-green-950">🛒 سلة المشتريات (${totalItems})</h3>
            <button onclick="state.isCartOpen = false; render();" class="w-8 h-8 rounded-full bg-white text-gray-600 hover:text-red-600 font-bold">✕</button>
