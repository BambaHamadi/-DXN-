    image: "https://images.unsplash.com/photo-1582719471384-894fbb16e074?auto=format&fit=crop&w=400&q=80"
  }
];

// حالة التطبيق
let state = {
  cart: [],
  selectedCategory: "الكل",
  searchQuery: "",
  isCartOpen: false,
  customerName: "",
  customerPhone: "",
  customerCity: "نواكشوط - الدار النعيم",
  paymentMethod: STORE_CONFIG.paymentMethods[0]
};

// أيقونة العلم الموريتاني SVG
const MAURITANIA_FLAG_SVG = `
  <div class="mauritania-flag-wrap w-10 h-7 border border-green-900/20">
    <svg viewBox="0 0 900 600" class="w-full h-full object-cover">
      <rect width="900" height="600" fill="#D01C1F"/>
      <rect y="120" width="900" height="360" fill="#00A95C"/>
      <path d="M 315,240 A 135,135 0 0,0 585,240 A 145,145 0 0,1 315,240 Z" fill="#FFD700"/>
      <polygon points="450,165 462,202 501,202 470,224 481,261 450,239 419,261 430,224 399,202 438,202" fill="#FFD700"/>
    </svg>
  </div>
`;

// إضافة منتج للسلة
function addToCart(productId) {
  const product = PRODUCTS.find(p => p.id === productId);
  const existing = state.cart.find(item => item.id === productId);
  if (existing) {
    existing.qty += 1;
  } else {
    state.cart.push({ ...product, qty: 1 });
  }
  render();
}

// تعديل الكمية
function updateQty(productId, delta) {
  const item = state.cart.find(i => i.id === productId);
  if (!item) return;
  item.qty += delta;
  if (item.qty <= 0) {
    state.cart = state.cart.filter(i => i.id !== productId);
  }
  render();
}

// إرسال الطلب عبر واتساب
function checkoutWhatsApp() {
  if (state.cart.length === 0) return alert("السلة فارغة! يرجى إضافة منتجات أولاً.");
  
  const total = state.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
  let msg = `*طلب جديد من متجر ${STORE_CONFIG.storeName}* 🌿\n`;
  msg += `────────────────────\n`;
  if (state.customerName) msg += `👤 *الاسم:* ${state.customerName}\n`;
  if (state.customerPhone) msg += `📱 *الهاتف:* ${state.customerPhone}\n`;
  msg += `📍 *العنوان:* ${state.customerCity}\n`;
  msg += `💳 *طريقة الدفع:* ${state.paymentMethod}\n`;
  msg += `────────────────────\n`;
  msg += `*المنتجات المطلوبة:*\n`;
  
  state.cart.forEach((item, idx) => {
    msg += `${idx + 1}. ${item.name} (×${item.qty}) = ${item.price * item.qty} ${STORE_CONFIG.currency}\n`;
  });
  
  msg += `────────────────────\n`;
  msg += `💰 *المجموع الكلي:* ${total} ${STORE_CONFIG.currency}\n`;
  msg += `🆔 كود العضوية المرجعي: ${STORE_CONFIG.memberId}`;

  const url = `https://wa.me/${STORE_CONFIG.whatsappNumber}?text=${encodeURIComponent(msg)}`;
  window.open(url, "_blank");
}

// دالة العرض الرئيسية
function render() {
  const categories = ["الكل", ...new Set(PRODUCTS.map(p => p.category))];
  const filteredProducts = PRODUCTS.filter(p => {
    const matchCat = state.selectedCategory === "الكل" || p.category === state.selectedCategory;
    const matchSearch = p.name.toLowerCase().includes(state.searchQuery.toLowerCase()) || 
                        p.desc.toLowerCase().includes(state.searchQuery.toLowerCase());
    return matchCat && matchSearch;
  });

  const totalItems = state.cart.reduce((sum, item) => sum + item.qty, 0);
  const totalPrice = state.cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

  document.getElementById("app").innerHTML = `
    <!-- الشريط العلوي -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-green-900/10 no-print">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl dxn-green text-white flex items-center justify-center font-black text-lg shadow-sm">
            DXN
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="font-extrabold text-base sm:text-lg text-gray-900 leading-tight">${STORE_CONFIG.storeName}</h1>
              ${MAURITANIA_FLAG_SVG}
            </div>
            <p class="text-xs text-green-800 font-semibold">${STORE_CONFIG.subTitle}</p>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <button onclick="window.print()" class="hidden sm:flex items-center gap-1.5 px-3 py-2 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-50 text-xs font-bold transition">
            🖨️ طباعة الكتالوج
          </button>
          <button onclick="state.isCartOpen = true; render();" class="relative dxn-green dxn-green-hover text-white px-4 py-2.5 rounded-xl font-bold text-sm flex items-center gap-2 shadow-sm transition">
            <span>🛒 السلة</span>
            <span class="bg-white text-green-900 text-xs font-black px-2 py-0.5 rounded-full">${totalItems}</span>
          </button>
        </div>
      </div>

      <!-- شريط المنتجات المتحرك -->
      <div class="product-ticker-container bg-green-900 text-white py-1.5 overflow-hidden text-xs font-semibold border-t border-green-800">
        <div class="product-ticker-track gap-8 px-4">
          ${[...PRODUCTS, ...PRODUCTS].map(p => `
            <span class="inline-flex items-center gap-2 whitespace-nowrap">
              <span class="text-amber-300">✦</span>
              <span>${p.name}</span>
              <span class="bg-green-800 px-2 py-0.5 rounded text-emerald-200">${p.price} ${STORE_CONFIG.currency}</span>
            </span>
          `).join("")}
        </div>
      </div>
    </header>

    <!-- القسم الترحيبي (Hero) -->
    <section class="hero-gradient border-b border-green-900/10 py-8 sm:py-12 px-4">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl space-y-3 text-center md:text-right">
          <span class="inline-block bg-white/80 text-green-900 border border-green-700/20 px-3 py-1 rounded-full text-xs font-bold">
            🌿 منتجات طبيعية 100% معتمدة في موريتانيا
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-gray-900 leading-snug">
            صحتك ثروتك.. اطلب منتجات <span class="dxn-text-green">DXN العالمية</span> الآن
          </h2>
          <p class="text-sm sm:text-base text-gray-700 font-medium">
            نوفر لك جميع المكملات الغذائية، المشروبات الصحية، ومنتجات العناية الشخصية مع توصيل سريع والدفع عبر بنكيلي، سداد، ومصرفي.
          </p>
          <div class="pt-2 flex flex-wrap justify-center md:justify-start gap-3 no-print">
            <a href="${STORE_CONFIG.registrationLink}" target="_blank" class="dxn-green dxn-green-hover text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow transition">
              ✨ سجل عضويتك مجاناً (${STORE_CONFIG.memberId})
            </a>
            <a href="https://wa.me/${STORE_CONFIG.whatsappNumber}" target="_blank" class="bg-white hover:bg-gray-50 text-green-900 border border-green-800/20 px-5 py-2.5 rounded-xl font-bold text-sm shadow-sm transition">
              📞 تواصل واتساب: ${STORE_CONFIG.displayPhone}
            </a>
          </div>
        </div>

        <!-- بطاقة معلومات الدفع السريع -->
        <div class="bg-white/90 backdrop-blur p-5 rounded-2xl card-shadow border border-green-900/10 w-full md:w-80 space-y-3">
          <h3 class="font-extrabold text-sm text-green-900 border-b pb-2">💳 وسائل الدفع المتاحة بالمقر</h3>
          <div class="grid grid-cols-2 gap-2 text-xs font-bold text-gray-700">
            <div class="bg-emerald-50 p-2.5 rounded-xl text-center border border-emerald-200">بنكيلي Bankily</div>
            <div class="bg-blue-50 p-2.5 rounded-xl text-center border border-blue-200">سداد Sedad</div>
            <div class="bg-amber-50 p-2.5 rounded-xl text-center border border-amber-200">مصرفي Masrifi</div>
            <div class="bg-gray-50 p-2.5 rounded-xl text-center border border-gray-200">نقداً بالمقر</div>
          </div>
          <p class="text-[11px] text-gray-500 text-center">📍 نواكشوط - الدار النعيم | مجتمع الناجحين</p>
        </div>
      </div>
    </section>

    <!-- أدوات البحث والتصفية -->
    <main class="max-w-7xl mx-auto w-full px-4 py-8 flex-1">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-6 no-print">
        <!-- التصنيفات -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1">
          ${categories.map(cat => `
            <button onclick="state.selectedCategory = '${cat}'; render();" 
              class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition ${
                state.selectedCategory === cat 
                  ? 'dxn-green text-white shadow-sm' 
                  : 'bg-white text-gray-700 hover:bg-green-50 border border-gray-200'
              }">
              ${cat}
            </button>
          `).join("")}
        </div>

        <!-- حقل البحث -->
        <div class="relative w-full sm:w-72">
          <input type="text" value="${state.searchQuery}" oninput="state.searchQuery = this.value; render();"
            placeholder="ابحث عن منتج (ريشي، سبيرولينا...)" 
            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-700" />
        </div>
      </div>

      <!-- شبكة المنتجات -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        ${filteredProducts.map(product => `
          <div class="bg-white rounded-2xl overflow-hidden card-shadow border border-green-900/5 flex flex-col justify-between hover:-translate-y-1 transition duration-200">
            <div>
              <div class="relative h-48 bg-gray-100 overflow-hidden">
                <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover" />
                <span class="absolute top-2.5 right-2.5 bg-white/95 text-green-900 text-[11px] font-extrabold px-2.5 py-1 rounded-lg shadow-sm">
                  ${product.category}
                </span>
                <span class="absolute bottom-2.5 left-2.5 bg-green-900/90 text-white text-[11px] font-bold px-2 py-0.5 rounded">
                  ${product.pv}
