          <div class="p-4 border-t bg-gray-50 space-y-3">
            <div class="flex items-center justify-between font-black text-base">
              <span>الإجمالي:</span>
              <span class="dxn-text-green text-xl">${totalPrice} ${STORE_CONFIG.currency}</span>
            </div>
            <button onclick="checkoutWhatsApp()" class="w-full bg-[#25D366] hover:bg-[#1ebe5d] text-white py-3 rounded-xl font-extrabold text-sm shadow transition flex items-center justify-center gap-2">
              📲 إتمام الطلب عبر واتساب
            </button>
          </div>
        </div>
      </div>
    ` : ""}

    <!-- التذييل (Footer) -->
    <footer class="bg-green-950 text-green-100 py-6 px-4 text-center text-xs space-y-2 mt-12">
      <p class="font-bold text-sm text-white">${STORE_CONFIG.storeName} — ${STORE_CONFIG.subTitle}</p>
      <p>للاستفسار والطلبات: ${STORE_CONFIG.displayPhone} | رقم العضوية: ${STORE_CONFIG.memberId}</p>
    </footer>
  `;
}

// تشغيل التطبيق عند التحميل
render();
</script>
</body>
</html>
